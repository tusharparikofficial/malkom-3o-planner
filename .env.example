# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://malkom:malkom@localhost:5432/malkom

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Public URL of the portal (frontend). ACS / metadata URLs are derived from it.
APP_BASE_URL=http://localhost:5173
# URL of the API as reachable by the browser (dev: vite proxies /api → this)
API_BASE_URL=http://localhost:3001

# ── Sessions ────────────────────────────────────────────────────────────────
# ≥ 32 chars. Generate: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-64-char-hex-string-change-me-change-me
SESSION_TTL_HOURS=12

# ── InstaSafe SSO (SAML 2.0) — leave unset until app registration is done ──
# When all SAML_* values are present, real SSO is enabled automatically.
# SAML_IDP_SSO_URL=https://wns.app.instasafe.io/console/idpproxy/validate/idp/<malkom-app-id>
# SAML_IDP_ENTITY_ID=https://wns.app.instasafe.io
# SAML_IDP_CERT=<base64 PEM of the IdP signing certificate>
# SAML_SP_ENTITY_ID=https://<malkom-domain>/saml/metadata
# SAML_SLO_URL=https://wns.app.instasafe.io/logout

# ── Provisioning ────────────────────────────────────────────────────────────
SEED_SUPER_ADMIN_EMAILS=tushar.parik@wns.com,u139289@wns.com

# ── Uploads ─────────────────────────────────────────────────────────────────
UPLOADS_DIR=./uploads
MAX_UPLOAD_MB=10

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
