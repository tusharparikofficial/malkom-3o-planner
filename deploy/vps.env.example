# Production .env for the VPS — lives at /opt/malkom-3o-planner/.env
# (never committed; docker-compose.prod.yml reads it)

NODE_ENV=production
LOG_LEVEL=info

# Postgres container credentials (DATABASE_URL is derived in compose)
DB_PASSWORD=<generate: openssl rand -hex 16>

# Public URL of the portal (used for redirects and the SAML SP config)
APP_BASE_URL=http://<vps-ip>:8090
API_BASE_URL=http://<vps-ip>:8090
WEB_PORT=8090

SESSION_SECRET=<generate: openssl rand -hex 32>
SESSION_TTL_HOURS=12

SEED_SUPER_ADMIN_EMAILS=tushar.parik@wns.com,u139289@wns.com

# Pilot phase: named-user login while InstaSafe SSO registration is pending.
# Every login is a tracked, named user — no anonymous access.
# Flip to false the day the SAML_* vars below are filled in.
DEV_LOGIN_ENABLED=true

# No TLS on the pilot port yet → cookies must not be Secure-only.
# Flip to true once the portal is behind HTTPS.
COOKIE_SECURE=false

# InstaSafe SSO (fill in after app registration, then set DEV_LOGIN_ENABLED=false)
# SAML_IDP_SSO_URL=
# SAML_IDP_ENTITY_ID=https://wns.app.instasafe.io
# SAML_IDP_CERT=
# SAML_SP_ENTITY_ID=
# SAML_SLO_URL=https://wns.app.instasafe.io/logout
